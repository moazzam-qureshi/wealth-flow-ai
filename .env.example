# Copy to .env (used by docker-compose) and/or ui/.env.local (used by `npm run dev`).
#
# ── Postgres ───────────────────────────────────────────────────────────────
# Inside docker-compose the host is the service name "postgres".
DATABASE_URL=postgres://wealthflow:wealthflow@postgres:5432/wealthflow
# For running migrations/dev from your host machine instead of inside compose:
# DATABASE_URL=postgres://wealthflow:wealthflow@localhost:5432/wealthflow
POSTGRES_USER=wealthflow
POSTGRES_PASSWORD=wealthflow
POSTGRES_DB=wealthflow

# ── SeaweedFS (S3-compatible blob storage for uploaded screenshots) ──────────
# Inside docker-compose the host is the service name "seaweedfs", S3 port 8333.
# These keys MUST match an identity in seaweedfs/s3.json (the `wealthflow` one).
# Change BOTH (and s3.json) for any real deployment. seaweedfs is only on the
# internal compose network, never exposed.
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_ACCESS_KEY=wealthflow
SEAWEEDFS_S3_SECRET_KEY=wealthflowsecret
SEAWEEDFS_BUCKET=screenshots

# ── OpenRouter (LLM provider) ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model IDs are config-driven so they can be swapped without code changes.
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_TEXT_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_APP_TITLE=WealthFlow AI
OPENROUTER_APP_URL=https://wealthflow.local

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
# In-process job scheduler (FX rates, news, weekly suggestions). Default: ON in
# production (NODE_ENV=production), OFF everywhere else — so `npm run dev`
# restarts don't keep re-firing the catch-up tick and burning LLM calls. Set to
# "on" to force it locally; set to "off" to disable in prod.
# WEALTHFLOW_SCHEDULER=on

# ── Auth (Better Auth, multi-user email+password) ────────────────────────────
# Generate a long random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the app (used for cookies / redirects). Match APP_BASE_URL.
BETTER_AUTH_URL=http://localhost:3000

# ── FX rate sources (for /api/cron/fx-rates) ─────────────────────────────────
# Free interbank source (no key needed). rate = PKR per 1 USD.
FX_INTERBANK_URL=https://open.er-api.com/v6/latest/USD
# Open-market (PKR free-market) rate source — wired in Step 3. Leave blank for now.
FX_OPENMARKET_URL=
